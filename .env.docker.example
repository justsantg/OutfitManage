# Copia este archivo a .env (junto a docker-compose.yml) y completa los valores.
# NUNCA comitees el .env real: contiene secretos de la instalación.

# --- Base de datos (contenedor Postgres local del compose) ---
POSTGRES_USER=tienda360
POSTGRES_PASSWORD=cambia-esta-clave-por-una-aleatoria-larga
POSTGRES_DB=tienda360

# --- JWT (obligatorio; usa RS256 con par de claves, o un JWT_SECRET de 64+ chars) ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DIAS=30

# --- CORS: orígenes públicos de catálogo y admin (allowlist, nunca wildcard) ---
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# --- Supabase Storage (service_role key: solo backend) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key
SUPABASE_BUCKET_IMAGES=products_images
SUPABASE_BUCKET_VIDEOS=products_videos

# --- Catálogo público ---
TIENDA_WHATSAPP_PHONE=573001234567
TIENDA_NOMBRE=Tienda360

# --- URLs públicas que los frontends embeben en build-time (NEXT_PUBLIC_*) ---
# Deben ser las URLs por las que el navegador del usuario llega al backend y al catálogo.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_CATALOGO_URL=http://localhost:3001

# --- Puertos publicados al host ---
BACKEND_PORT=3000
CATALOGO_PORT=3001
ADMIN_PORT=3002
