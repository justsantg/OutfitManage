# Configuración General del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
# Por defecto: PostgreSQL local para desarrollo.
# Estado de la migración de la base de datos a Supabase: PENDIENTE de verificación. Hasta
# confirmarla, el entorno de referencia es el PostgreSQL local. Para apuntar a Supabase, usa la
# connection string del pooler (el host directo db.<proyecto>.supabase.co solo resuelve por IPv6):
# DATABASE_URL="postgresql://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda360_dev?schema=public"

# Configuración de JWT — obligatoria, sin valor por defecto embebido en el código.
# Opción A (recomendada, RS256): define JWT_PRIVATE_KEY + JWT_PUBLIC_KEY (par de claves PEM).
# Opción B (HS256, solo si no usas RS256): define JWT_SECRET con un valor aleatorio de 64+ caracteres.
# El backend falla al arrancar si no se define ninguna de las dos.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
# Vida del refresh token en días (rotación en cada uso, ver Sección 5 del SRS).
JWT_REFRESH_EXPIRATION_DIAS="30"

# Seguridad y Dominios Permitidos (Allowlist) — nunca wildcard, ver SEC-03 de la auditoría
CORS_ORIGIN="http://localhost:3001,http://localhost:3002"

# Almacenamiento de Imágenes y Videos (Supabase Storage)
# Decisión oficial de arquitectura: ADR-008 (revisado en SRS v1.2) adopta Supabase Storage.
# SUPABASE_KEY es la service_role key: solo backend, nunca en variables NEXT_PUBLIC_*.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-clave-de-servicio-de-supabase"
SUPABASE_BUCKET_IMAGES="products_images"
SUPABASE_BUCKET_VIDEOS="products_videos"

# Catálogo público — WhatsApp y nombre de tienda para el deep link server-side (SRS 6.5)
TIENDA_WHATSAPP_PHONE="573001234567"
TIENDA_NOMBRE="Tienda360"
